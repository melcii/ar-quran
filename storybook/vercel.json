{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix server",
  "buildCommand": "EXPO_PUBLIC_STUDIO_URL=${EXPO_PUBLIC_STUDIO_URL:-same-origin} npx expo export --platform web",
  "outputDirectory": "dist",
  "functions": {
    "api/studio.mjs": {
      "maxDuration": 30,
      "includeFiles": "server/surahs.json"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/studio?__p=api/:path*" },
    { "source": "/files/:path*", "destination": "/api/studio?__p=files/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
